{
	"$schema": "./node_modules/wrangler/config-schema.json",

	// emerald-wani-web: 画面配信(SSR) + REST API + 認証・セッション
	// 責務は doc/designs/02-architecture.md 3.3 を参照。
	"name": "emerald-wani-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-03",

	// SvelteKit / better-auth が利用する Node.js API と AsyncLocalStorage を有効にする。
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	"observability": {
		"enabled": true
	},

	// D1: ユーザ / デッキ / 戦績 / 監査（doc/designs/08-data-model.md）
	// database_id は本番（emerald-wani-db）の実 ID。realtime Worker 側と必ず同じ値にすること。
	// **ローカルの SQLite はこの ID ごとに分かれる。** ID を変えたら
	// `pnpm db:migrate:local` を流し直さないと「no such table」になる。
	// ステージング（emerald-wani-db-stg）は 2dc94590-4d7b-4c7a-90eb-d6aed221fee8。
	// stg へデプロイするときは wrangler の環境ブロックを足して差し替える（doc/deploy.md）。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emerald-wani-db",
			"database_id": "0f43d043-78ce-4a1a-9449-05f188cd4af7",
			"migrations_dir": "drizzle"
		}
	],

	// R2: リプレイ。書き込みは realtime Worker（Queue consumer）だけが行い、
	// web はここから読んで認可済みのユーザーへ配信する。バケットは公開しない
	// （doc/designs/09-api-protocol.md 1節）。
	"r2_buckets": [
		{
			"binding": "REPLAYS",
			"bucket_name": "emerald-wani-replays"
		}
	],

	// Durable Objects は realtime Worker 側で定義し、ここからは script_name で参照する。
	// この分割理由は doc/designs/02-architecture.md 3.2（getPlatformProxy の制約）を参照。
	"durable_objects": {
		"bindings": [
			{
				"name": "MATCH_ROOM",
				"class_name": "MatchRoom",
				"script_name": "emerald-wani-realtime"
			},
			{
				"name": "MATCH_QUEUE",
				"class_name": "MatchQueue",
				"script_name": "emerald-wani-realtime"
			},
			{
				"name": "GUEST_GUARD",
				"class_name": "GuestIssuanceGuard",
				"script_name": "emerald-wani-realtime"
			}
		]
	},

	// レート制限バインディング（doc/designs/11-security-controls.md 11.4）。
	// **バースト制限にしか使えない**: period は 10 か 60 秒のみ、カウンタは
	// ロケーションごとに独立した eventually consistent な実装。厳密な時間窓
	// （ゲスト発行 3件/時間）は GUEST_GUARD の DO が担当する。
	// namespace_id は Worker 内で一意な任意の識別子（Cloudflare 側で作成不要）。
	"ratelimits": [
		{ "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_GUEST_BURST", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
		{ "name": "RL_MATCHMAKING", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_REPORT_WRITE", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_WS_TICKET", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RL_API_READ", "namespace_id": "1006", "simple": { "limit": 300, "period": 60 } }
	],

	"vars": {
		// 公開してよい値のみをここに置く。シークレットは .dev.vars / wrangler secret へ。
		// （doc/designs/04-dev-environment.md 5.5 / doc/designs/13-secrets-lifecycle.md）
		"ORIGIN": "http://localhost:5173",

		// メール送信元。ローカルでは配送業者を呼ばずログへ出す（doc/email.md）。
		"EMAIL_FROM": "エメラルドワニ <no-reply@localhost>",

		// development のときだけメール配送のログ出力フォールバックと、
		// Turnstile 未設定での素通りを許可する（doc/designs/11-security-controls.md 11.4）。
		"ENVIRONMENT": "development",

		// Turnstile のサイトキー（公開値）。空ならウィジェットを描画せず、サーバ側の
		// 検証も飛ばす（development のときのみ）。本番・ステージングでは必ず入れる。
		"PUBLIC_TURNSTILE_SITE_KEY": ""
	}

	//
	// Queue の producer / consumer と archive 再照合の Cron は realtime Worker 側に置く。
	// 終局を検知するのも DO からログを取り出すのも realtime の責務であり、web に
	// Queue バインディングを持たせる理由が無いため（doc/designs/03-tech-stack.md 4.3 の
	// 「web Worker の定期実行」からの意図的な変更。理由は doc/designs/21-roadmap.md）。
}
