{
	"$schema": "./node_modules/wrangler/config-schema.json",

	// emerald-wani-web: 画面配信(SSR) + REST API + 認証・セッション
	// 責務は doc/designs/02-architecture.md 3.3 を参照。
	"name": "emerald-wani-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-03",

	// SvelteKit / better-auth が利用する Node.js API と AsyncLocalStorage を有効にする。
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	"observability": {
		"enabled": true
	},

	// D1: ユーザ / デッキ / 戦績 / 監査（doc/designs/08-data-model.md）
	// database_id はローカル開発用のプレースホルダ。実IDは `wrangler d1 create` 後に差し替える。
	// realtime Worker 側と同じ値を使うこと（同じローカル SQLite を共有するため）。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emerald-wani-db",
			"database_id": "00000000-0000-4000-8000-000000000001",
			"migrations_dir": "drizzle"
		}
	],

	// R2: リプレイ。書き込みは realtime Worker（Queue consumer）だけが行い、
	// web はここから読んで認可済みのユーザーへ配信する。バケットは公開しない
	// （doc/designs/09-api-protocol.md 1節）。
	"r2_buckets": [
		{
			"binding": "REPLAYS",
			"bucket_name": "emerald-wani-replays"
		}
	],

	// Durable Objects は realtime Worker 側で定義し、ここからは script_name で参照する。
	// この分割理由は doc/designs/02-architecture.md 3.2（getPlatformProxy の制約）を参照。
	"durable_objects": {
		"bindings": [
			{
				"name": "MATCH_ROOM",
				"class_name": "MatchRoom",
				"script_name": "emerald-wani-realtime"
			},
			{
				"name": "MATCH_QUEUE",
				"class_name": "MatchQueue",
				"script_name": "emerald-wani-realtime"
			},
			{
				"name": "GUEST_GUARD",
				"class_name": "GuestIssuanceGuard",
				"script_name": "emerald-wani-realtime"
			}
		]
	},

	"vars": {
		// 公開してよい値のみをここに置く。シークレットは .dev.vars / wrangler secret へ。
		// （doc/designs/04-dev-environment.md 5.5 / doc/designs/13-secrets-lifecycle.md）
		"ORIGIN": "http://localhost:5173",

		// メール送信元。ローカルでは配送業者を呼ばずログへ出す（doc/email.md）。
		"EMAIL_FROM": "エメラルドワニ <no-reply@localhost>",

		// development のときだけメール配送のログ出力フォールバックを許可する。
		"ENVIRONMENT": "development"
	}

	// 以下はフェーズ進行に合わせて追加する（未使用のバインディングは意図的に置かない）:
	//   - ratelimit バインディング  : フェーズ6（doc/designs/11-security-controls.md 11.4）
	//
	// Queue の producer / consumer と archive 再照合の Cron は realtime Worker 側に置く。
	// 終局を検知するのも DO からログを取り出すのも realtime の責務であり、web に
	// Queue バインディングを持たせる理由が無いため（doc/designs/03-tech-stack.md 4.3 の
	// 「web Worker の定期実行」からの意図的な変更。理由は doc/designs/21-roadmap.md）。
}
