{
	"$schema": "../../node_modules/wrangler/config-schema.json",

	// emerald-wani-realtime: WebSocket の Upgrade 中継 + Durable Objects の実装
	// 責務は doc/designs/02-architecture.md 3.3 / 3.5 を参照。
	// このワーカーはチケットの検証を行わない（検証主体は MatchRoom DO 自身）。
	"name": "emerald-wani-realtime",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_compat"],

	"observability": {
		"enabled": true
	},

	// web Worker と同じ D1 を参照する。database_id は必ず web 側と一致させること
	// （ローカルでは同じ SQLite ファイルを共有するため）。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emerald-wani-db",
			"database_id": "00000000-0000-4000-8000-000000000001",
			"migrations_dir": "../../drizzle"
		}
	],

	// R2: 終局後のリプレイ（doc/designs/09-api-protocol.md 4節）。
	// web Worker 側も同じバケットを読み取り専用の用途で参照する。
	"r2_buckets": [
		{
			"binding": "REPLAYS",
			"bucket_name": "emerald-wani-replays"
		}
	],

	// Queues: 終局した matchId だけを流す（本体は DO の /internal/export から取る）。
	// producer（MatchRoom）と consumer を同じワーカーに置くことで、web 側に
	// Queue バインディングを持たせずに済む（doc/designs/07-durable-objects.md 9.2）。
	"queues": {
		"producers": [{ "binding": "MATCH_EVENTS", "queue": "match-events" }],
		"consumers": [
			{
				"queue": "match-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "match-events-dlq"
			}
		]
	},

	// Queues 無料プランの保持期間（24時間）を踏まえたアーカイブ再試行のフォールバック。
	// D1 の match.replay_key IS NULL を1時間ごとに直接スキャンする
	// （doc/designs/03-tech-stack.md 4.3）。
	"triggers": {
		"crons": ["0 * * * *"]
	},

	// DO の実体はこのワーカーが持つ（doc/designs/07-durable-objects.md 9.1）。
	"durable_objects": {
		"bindings": [
			{ "name": "MATCH_ROOM", "class_name": "MatchRoom" },
			{ "name": "MATCH_QUEUE", "class_name": "MatchQueue" },
			{ "name": "GUEST_GUARD", "class_name": "GuestIssuanceGuard" }
		]
	},

	// SQLite ストレージバックエンドを明示宣言する（新方式の exports）。
	"exports": {
		"MatchRoom": { "type": "durable-object", "storage": "sqlite" },
		"MatchQueue": { "type": "durable-object", "storage": "sqlite" },
		"GuestIssuanceGuard": { "type": "durable-object", "storage": "sqlite" }
	},

	"vars": {
		// WebSocket の Origin 検証に使う許可リスト（カンマ区切り）。
		// 本番・ステージングでは実ドメインへ差し替える。
		"ALLOWED_WS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
	}
}
